    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": true
    },
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_TIME_44",
          "file": "fonts/Outfit-Time.ttf",
