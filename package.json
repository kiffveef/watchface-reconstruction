        },
        {
          "type": "font",
          "name": "FONT_DATE_10",
          "file": "fonts/Outfit-Text.ttf",
          "characterRegex": "[A-Z0-9 ]",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_VALUE_15",
          "file": "fonts/Outfit-Text.ttf",
          "characterRegex": "[0-9,-]",
          "compatibility": "2.7"
        },
        {
          "type": "font",
          "name": "FONT_LABEL_9",
          "file": "fonts/Outfit-Text.ttf",
          "characterRegex": "[A-Z]",
          "compatibility": "2.7"
        }
      ]
    }
  }
